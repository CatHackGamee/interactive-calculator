<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Калькулятор</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f0f0f0;
            margin: 0;
            padding: 40px;
        }

        .calc {
            background: white;
            border: 1px solid #ccc;
            padding: 20px;
            width: 350px;
            margin: 0 auto;
        }

        h3 {
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 20px;
        }

        .input-block {
            margin-bottom: 15px;
        }

        .input-block label {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
        }

        .input-block input {
            width: 100%;
            padding: 8px;
            border: 1px solid #999;
            font-size: 14px;
            box-sizing: border-box;
        }

        .buttons {
            margin: 20px 0;
        }

        button {
            padding: 8px 12px;
            margin-right: 8px;
            margin-bottom: 8px;
            border: 1px solid #666;
            background: #e0e0e0;
            cursor: pointer;
            font-size: 14px;
        }

        button:hover {
            background: #ccc;
        }

        .result-block {
            margin-top: 15px;
        }

        .result-block label {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
        }

        .out {
            border: 1px solid #999;
            padding: 10px;
            min-height: 40px;
            background: #fafafa;
            font-size: 16px;
        }
    </style>
</head>
<body>
    <div class="calc">
        <h3>Калькулятор</h3>
        
        <div class="input-block">
            <label>Первое число</label>
            <input type="text" id="num1" placeholder="Введите число">
        </div>

        <div class="input-block">
            <label>Второе число</label>
            <input type="text" id="num2" placeholder="Введите число">
        </div>

        <div class="buttons">
            <button id="btnSum">Сумма</button>
            <button id="BtnDiff">Разность</button>
            <button id="BtnMult">Произведение</button>
            <button id="BtnDiv">Деление</button>
        </div>

        <div class="result-block">
            <label>Результат</label>
            <div class="out" id="result">---</div>
        </div>
    </div>

    <script>
        let input1 = document.getElementById('num1');
        let input2 = document.getElementById('num2');
        let resultDiv = document.getElementById('result');

        function getNumbers() {
            let a = input1.value;
            let b = input2.value;
            
            if (a === '' || b === '') {
                resultDiv.innerHTML = 'Ошибка: заполните оба поля';
                return null;
            }
            
            let n1 = Number(a);
            let n2 = Number(b);
            
            if (isNaN(n1) || isNaN(n2)) {
                resultDiv.innerHTML = 'Ошибка: введите цифры';
                return null;
            }
            
            return { n1, n2 };
        }

        function sum() {
            let nums = getNumbers();
            if (nums) {
                let res = nums.n1 + nums.n2;
                resultDiv.innerHTML = res;
            }
        }

        function diff() {
            let nums = getNumbers();
            if (nums) {
                let res = nums.n1 - nums.n2;
                resultDiv.innerHTML = res;
            }
        }

        function mult() {
            let nums = getNumbers();
            if (nums) {
                let res = nums.n1 * nums.n2;
                resultDiv.innerHTML = res;
            }
        }

        function div() {
            let nums = getNumbers();
            if (nums) {
                if (nums.n2 === 0) {
                    resultDiv.innerHTML = 'Ошибка: деление на ноль';
                    return;
                }
                let res = nums.n1 / nums.n2;
                resultDiv.innerHTML = res;
            }
        }

        document.getElementById('btnSum').onclick = sum;
        document.getElementById('BtnDiff').onclick = diff;
        document.getElementById('BtnMult').onclick = mult;
        document.getElementById('BtnDiv').onclick = div;
    </script>
</body>
</html>
